{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "即刻",
  "version": "2.2.2",
  "identifier": "com.jike.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3004",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "即刻",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "visible": true,
        "maximized": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*.mp4",
          "**/*.MP4"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "视频工作流",
    "longDescription": "即刻 - 基于节点式画布的 AI 视频工作流编排桌面应用",
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "language": [
          "zh-CN"
        ]
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "resources/ffmpeg/": "ffmpeg/"
    },
    "publisher": "小明",
    "copyright": "© 2026 小明"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFRUVGREFFMDM3NjQyMTUKUldRVlFuWURydjN1SGhKUVRuMlM3ZGl2Tml1Vzg4eVg0RHcvWVRwMGpGaFBRdStLT2RkdDRnMGQK",
      "endpoints": [
        "https://github.com/jikedh/jike-release/releases/latest/download/latest.json"
      ]
    }
  }
}
