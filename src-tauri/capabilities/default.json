{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "即刻主窗口默认能力集",
  "webviews": [
    "main",
    "canvas-*"
  ],
  "permissions": [
    "allow-browser-open",
    "allow-browser-sync",
    "allow-browser-close",
    "allow-browser-go-back",
    "allow-browser-go-forward",
    "allow-browser-capture",
    "allow-storage-select-directory",
    "allow-storage-ensure-project",
    "allow-storage-list-projects",
    "allow-storage-save-canvas",
    "allow-storage-load-canvas",
    "allow-storage-save-media",
    "allow-storage-read-media",
    "allow-storage-write-raw-file",
    "allow-storage-read-raw-file",
    "allow-storage-scan-asset-library",
    "allow-storage-delete-raw-path",
    "allow-storage-rename-raw-path",
    "allow-storage-list-media",
    "allow-storage-delete-media",
    "allow-storage-download-media",
    "allow-storage-save-buffer-to-file",
    "allow-storage-media-exists",
    "allow-storage-rename-project",
    "allow-storage-delete-project",
    "allow-storage-copy-project",
    "allow-storage-export-project",
    "allow-storage-import-project",
    "allow-storage-get-default-path",
    "allow-storage-ensure-project-dir",
    "allow-storage-write-file",
    "allow-storage-read-file",
    "allow-storage-delete-file",
    "allow-storage-list-files",
    "allow-storage-download-file",
    "allow-storage-file-exists",
    "allow-storage-read-absolute-file",
    "allow-download-image-as-buffer",
    "allow-download-image-as-base64",
    "allow-download-image-to-file",
    "allow-download-image-with-save-dialog",
    "allow-notification-show",
    "allow-notification-is-supported",
    "allow-tracking-send",
    "allow-tracking-update-status",
    "allow-debug-toggle-dev-tools",
    "allow-debug-is-dev",
    "allow-debug-get-app-version",
    "allow-debug-capture-page",
    "allow-video-processing-trim",
    "allow-video-processing-burn-annotations",
    "allow-video-processing-cleanup-annotation-webview-fallback",
    "allow-video-split-mp4-by-seconds",
    "allow-get-local-file-info",
    "allow-upload-local-file-to-backend",
    "allow-upload-local-file-with-presigned-url",
    "allow-upload-local-file-to-presigned-url",
    "allow-copy-video-url-to-oss",
    "allow-copy-media-url-to-oss",
    "core:default",
    "core:window:default",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "core:event:default",
    "core:app:default",
    "core:path:default",
    "core:resources:default",
    "core:menu:default",
    "core:image:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-copy-file",
    "fs:allow-app-read",
    "fs:allow-app-write",
    "fs:allow-app-meta",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPDATA"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DOCUMENT"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$DESKTOP"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOWNLOAD"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$HOME"
        },
        {
          "path": "$VIDEO/**"
        },
        {
          "path": "$PICTURE/**"
        },
        {
          "path": "$MUSIC/**"
        }
      ]
    },
    "notification:default",
    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "shell:default",
    "shell:allow-open",
    "store:default",
    "os:default",
    "process:default",
    "process:allow-exit",
    "process:allow-restart",
    "updater:default",
    "opener:default",
    "opener:allow-open-url",
    "opener:allow-open-path",
    "global-shortcut:default"
  ]
}