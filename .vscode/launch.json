{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "安装依赖",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm install",
            "cwd": "${workspaceFolder:jike}"
        },
        {
            "name": "本地启动 Electron",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev:electron",
            "cwd": "${workspaceFolder:jike}"
        },
        {
            "name": "构建 Windows 可执行文件",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run build:win",
            "cwd": "${workspaceFolder:jike}"
        }
    ]
}